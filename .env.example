# Server
DEVINORIUM_HOST=127.0.0.1
DEVINORIUM_PORT=7878
# A long random secret used to sign session cookies. Generate with:
#   openssl rand -base64 48
DEVINORIUM_SESSION_KEY=change-me-to-a-long-random-secret-please-64-chars-min

# Database
DEVINORIUM_DB_URL=sqlite:data/devinorium.db?mode=rwc

# Bootstrap owner account (created on first run only)
# A strong password for the first user, who becomes the owner and can create other accounts.
DEVINORIUM_BOOTSTRAP_USERNAME=owner
DEVINORIUM_BOOTSTRAP_PASSWORD=change-me-to-a-strong-password

# Default model for new threads (use a free model for testing, e.g. glm-5-2)
DEVINORIUM_DEFAULT_MODEL=glm-5-2

# Security
# Trust proxy headers (X-Forwarded-For, X-Forwarded-Proto) from a reverse proxy.
# Only enable when behind a trusted reverse proxy.
DEVINORIUM_TRUST_PROXY=false
# Max request body size in bytes (default 16 MiB, for image uploads)
DEVINORIUM_MAX_BODY_BYTES=16777216
# Set the Secure flag on session cookies. Enable when serving over HTTPS
# (via a reverse proxy or Cloudflare Tunnel). Leave false for plain HTTP.
DEVINORIUM_SECURE_COOKIE=false
# Optional: an explicit allowed origin for CSRF checks (e.g. https://devinorium.example).
# When set, POST/PUT/PATCH/DELETE requests must have an Origin header matching this.
# When unset, the Origin/Referer host must match the request Host header.
# DEVINORIUM_ALLOWED_ORIGIN=https://devinorium.example

# Tailscale (optional, see docs/deployment.md "Option D")
# Path to the tailscale CLI, when it is not on PATH.
# DEVINORIUM_TAILSCALE_BIN=tailscale
# Publish this server as https://<machine>.<tailnet>.ts.net on your Tailnet
# at startup via tailscale serve. Requires tailscaled running, a logged-in
# node, and MagicDNS enabled on the tailnet.
DEVINORIUM_TAILSCALE_SERVE=false
# Tailnet-side HTTPS port for the serve mapping.
DEVINORIUM_TAILSCALE_SERVE_PORT=443

# Bundled local mode (used by the desktop app; do not set for normal servers).
# When set, requests bearing "Authorization: Bearer <token>" are mapped onto an
# auto-created passwordless "local" owner account, and the server exits when
# stdin closes (the app holds the pipe). Meant for 127.0.0.1 binds only.
# DEVINORIUM_LOCAL_TOKEN=some-long-random-token
