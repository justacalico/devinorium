# Build artifacts
/target/
**/*.rs.bk

# Frontend build output (ignore built assets, keep placeholder)
/frontend/dist/assets/
/frontend/dist/wasm/
# Flutter web build output (generated by scripts/build-flutter.sh)
/frontend/dist/canvaskit/
/frontend/dist/icons/
/frontend/dist/flutter.js
/frontend/dist/flutter_bootstrap.js
/frontend/dist/flutter_service_worker.js
/frontend/dist/main.dart.js
/frontend/dist/main.dart.mjs
/frontend/dist/main.dart.wasm
/frontend/dist/manifest.json
/frontend/dist/version.json
/frontend/dist/favicon.png
/frontend/dist/.last_build_id

# CI tool cache
/.ci-tools/

# Android signing files (generated in CI from secrets)
/flutter/android/app/key.properties
/flutter/android/app/*.jks
/flutter/android/app/*.keystore

# Flutter/Dart build artifacts
/flutter/build/
/flutter/.dart_tool/
/flutter/.flutter-plugins
/flutter/.flutter-plugins-dependencies
/flutter/.packages
/flutter/pubspec.lock

# Node.js / Tailwind
/frontend/node_modules/
/frontend/assets/styles.css

# SQLite databases
*.db
*.db-shm
*.db-wal
data/
!migrations/**/data

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Runtime upload/attachment cache
/.devinorium-attachments/

# Logs
*.log
logs/

# OS
Thumbs.db
